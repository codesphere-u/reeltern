    {
      "name": "create_plan",
      "description": "Save an immutable timeline revision with ordered clips and framing.",
      "inputSchema": {
        "properties": {
          "clips": {
            "description": "Ordered playback clips",
            "items": {
              "additionalProperties": false,
              "properties": {
                "asset_id": {
                  "description": "SHA-256 asset ID",
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "start": {
                  "default": 0,
                  "description": "Source start s",
                  "minimum": 0,
                  "type": "number"
                },
                "end": {
                  "default": null,
                  "description": "Source end s",
                  "exclusiveMinimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "speed": {
                  "default": 1,
                  "description": "Speed 0.25–4x",
                  "maximum": 4.0,
                  "minimum": 0.25,
                  "type": "number"
                },
                "reason": {
                  "default": "User selection",
                  "description": "Clip reason",
                  "maxLength": 500,
                  "type": "string"
                }
              },
              "required": [
                "asset_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "preset": {
            "default": "landscape",
            "description": "Output preset",
            "enum": [
              "landscape",
              "portrait",
              "square",
              "fhd",
              "reels"
            ],
            "type": "string"
          },
          "fit": {
            "default": "contain",
            "description": "Contain, cover, or blur_fill",
            "enum": [
              "contain",
              "cover",
              "blur_fill"
            ],
            "type": "string"
          },
          "parent": {
            "default": null,
            "description": "Parent plan ID",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "default": "Manual edit",
            "description": "Revision note",
            "type": "string"
          },
          "transcript_ids": {
            "default": null,
            "description": "Transcript IDs",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "clips"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
