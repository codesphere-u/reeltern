          "duration": {
            "default": 3.0,
            "description": "Duration in sec",
            "maximum": 30.0,
            "minimum": 0.5,
            "type": "number"
          },
          "preset": {
            "default": "landscape",
            "description": "Frame size preset",
            "enum": [
              "landscape",
              "portrait",
              "square",
              "fhd",
              "reels"
            ],
            "type": "string"
          },
          "background": {
            "default": "#0f172a",
            "description": "Hex backdrop e.g. #0f172a",
            "pattern": "^#[0-9a-fA-F]{6}$",
